# ================================================================
# 记账小助手 · 环境变量示例
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，切勿提交）
# ================================================================

# ---- 服务端口（容器内固定 8686，用于对接 CNB 端口预览）----
PORT=8686

# ---- 数据库文件位置（默认 <项目>/data/money.db，Docker 中建议挂 volume）----
# DB_PATH=/data/money.db

# ---- CNB 云端：以下三项由平台自动注入，无需手动配置 ----
# CNB_API_ENDPOINT=https://api.cnb.cool
# CNB_REPO_SLUG=your-org/your-repo
# CNB_TOKEN=auto_injected

# ---- 本地开发：想让「AI 记账 / AI 洞察」生效时手动填写 ----
# BASE_URL=https://api.cnb.cool/your-org/your-repo/-/ai-ide/v2
# API_KEY=your_cnb_access_token
# MODEL_ID=deepseek-v4-flash

# ---- 大模型请求超时（秒）----
# LLM_TIMEOUT=60
